# Docker Compose PostgreSQL settings
POSTGRES_DB=indtrans
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# Direct backend run outside Docker (optional; Docker Compose injects these for you)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/indtrans
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change_me
SPRING_DATASOURCE_DRIVER=org.postgresql.Driver

# 32+ char random string - generate with: openssl rand -hex 32
APP_JWT_SECRET=CHANGE_ME_TO_A_VERY_LONG_RANDOM_SECRET_MIN_32_CHARS

# Bootstrap admin account for non-H2 deployments.
# Required the first time you run the Docker/PostgreSQL stack unless you create
# the admin user some other way.
APP_BOOTSTRAP_ADMIN_EMAIL=operations@indtransfreightsolutions.com
APP_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# Comma-separated list of origins allowed to call the API.
# Put your production domain here, e.g. https://indtrans.yourdomain.com
APP_CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,https://your-domain.com

# Public URL where the SPA is reachable (used in password-reset emails)
APP_PUBLIC_URL=https://your-domain.com

# SMTP - leave SPRING_MAIL_HOST empty to log reset links instead of emailing them.
# Examples:
#   Gmail:     SPRING_MAIL_HOST=smtp.gmail.com      SPRING_MAIL_PORT=587   (use an App Password)
#   Office365: SPRING_MAIL_HOST=smtp.office365.com  SPRING_MAIL_PORT=587
#   Zoho IN:   SPRING_MAIL_HOST=smtp.zoho.in        SPRING_MAIL_PORT=587
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
APP_MAIL_FROM=no-reply@indtransfreightsolutions.com
